{
  "buildCommand": "npm run vercel-build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/appointments",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/monthly-briefing",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron/auto-resume",
      "schedule": "0 * * * *"
    }
  ]
}
