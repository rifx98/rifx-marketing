# Canonical deployment (required in production). APP_URL must be the exact
# HTTPS origin only: no path, query, fragment, credentials, or surrounding quotes.
NODE_ENV=production
APP_URL=https://rifx-marketing.com
NEXT_PUBLIC_APP_URL=https://rifx-marketing.com

# Supabase (service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application cryptography (independent random values, stored as Vercel
# Sensitive environment variables). CRON_SECRET authenticates Vercel cron
# routes and the immediate WhatsApp worker trigger. WHATSAPP_WORKER_SECRET is
# server-only and should also contain at least 32 random characters.
JWT_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
WHATSAPP_WORKER_SECRET=
SOCIAL_WORKER_SECRET=

# Distributed rate limiting (required because production fails closed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp / Meta
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional E.164 destination for operational alerts (for example +573001234567)
ADMIN_NOTIFICATION_PHONE=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Meta configuration IDs are numeric. Keep FACEBOOK_APP_SECRET server-only.
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=
NEXT_PUBLIC_FACEBOOK_ADS_CONFIG_ID=

# Google OAuth and Calendar
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy Gemini alias used by older flows; prefer GEMINI_API_KEY when possible.
GOOGLE_API_KEY=

# Billing
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_START=
LEMONSQUEEZY_VARIANT_PLUS=
LEMONSQUEEZY_VARIANT_MASTER=
LEMONSQUEEZY_WEBHOOK_SECRET=
PAYPHONE_WEBHOOK_SECRET=

# Private object storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Social publishing queue and providers
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
META_GRAPH_API_VERSION=v24.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI providers (configure only providers the deployment uses)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

# Web Push (optional; all three must be configured together)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com

# Tina CMS build (optional when the CMS admin is not deployed)
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main

# Bounded worker tuning (optional)
APPOINTMENT_BATCH_SIZE=50
APPOINTMENT_CONCURRENCY=5
FOLLOW_UP_BATCH_SIZE=50
MESSAGE_BATCH_SIZE=50
SOCIAL_DISPATCH_BATCH_SIZE=10
MAX_RETRIES=3

# Development-only flags. Never enable debug/mock output in production.
AI_DEBUG_ARTIFACTS=0
MOCK_SOCIAL_API=0
PURE_SHARP_MODE=0
USE_FLUX=0
USE_GROQ=0
USE_OPENAI=0
USE_OPENAI_FALLBACK=0
FORCE_OPENAI=0
