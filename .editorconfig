# EditorConfig helps maintain consistent coding styles for multiple developers and environments
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,md,yml,yaml,sql}]
indent_style = space
indent_size = 2
